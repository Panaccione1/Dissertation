\vskip 0.55in {\bfseries Figure}\hfill {\bfseries Page}\vskip 0.25em\rm 
\contentsline {figure}{\numberline {3.1}{\ignorespaces Simulated electron concentration during the funneling phase following a heavy-ion strike in a reverse-biased n$^+$/p junction. The dense electron-hole plasma temporarily extends the high-field depletion region deep into the substrate, collecting charge from a volume far larger than the geometric depletion region.}}{48}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Electrostatic potential distribution during funneling, showing the field distortion caused by the ion track. The funnel depth scales with LET and substrate doping, reaching several micrometers for high-LET heavy ions in lightly doped substrates~\cite {dodd2003basic}.}}{49}{figure.3.2}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Taxonomy of single-event effects in microelectronic devices, organized by recoverability (soft vs.\ hard) and affected circuit element. Effects in bold are those most critical for SRAM-based FPGA operation in nuclear instrumentation applications.}}{49}{figure.3.3}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Generation of a single-event transient (SET) at a CMOS inverter output. The ion track deposits charge at a reverse-biased drain junction, driving the output voltage transiently toward the supply rail. Pulse width is determined by the collected charge and the drive strength of adjacent transistors~\cite {ferletcavrois2013set}.}}{51}{figure.3.4}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces SET propagation and capture by a flip-flop. The SET (shaded pulse) traverses the combinational logic cone and arrives at the flip-flop's data input. It is captured and causes an SEU only if it overlaps with the flip-flop's setup-and-hold window around the clock edge~\cite {ferletcavrois2013set}.}}{52}{figure.3.5}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Cross-sectional schematic of single-event burnout (SEB) in an n-channel power MOSFET. The heavy-ion track (dashed) deposits charge in the epitaxial drain that forward-biases the parasitic n-p-n transistor base-emitter junction, initiating regenerative feedback and destructive current~\cite {sexton2003destructive}.}}{54}{figure.3.6}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Single-event gate rupture (SEGR) mechanism. The transient increase in gate-oxide field caused by the ion-track plasma can locally exceed the intrinsic breakdown field of the SiO$_2$, permanently rupturing the gate dielectric and rendering the transistor non-functional~\cite {sexton2003destructive}.}}{55}{figure.3.7}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Measured SEGR onset $V_{\rm GS}$ as a function of heavy-ion LET for several gate-metal species. The onset voltage decreases with increasing LET, imposing a derating requirement on operating voltage for power devices in heavy-ion environments~\cite {sexton2003destructive}.}}{56}{figure.3.8}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Overview of fault-tolerant mechanisms for SRAM-based FPGAs, ranging from single-level flip-flop TMR to full-system architectural redundancy. Each level adds correction capability at the cost of increased resource utilization~\cite {kastensmidt2014survey}.}}{59}{figure.3.9}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Voter logic flowchart for a TMR system. Each output bit from the three replicas is majority-voted independently; disagreement among replicas can be flagged as a fault indicator without interrupting correct output generation~\cite {lyons1962tmr,johnson2010voter}.}}{60}{figure.3.10}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Summary of testing approaches for radiation hardness assurance of digital electronics, organized by radiation source, simulated environment, and measured effect. Each approach has characteristic advantages and limitations regarding representativeness, cost, and achievable fluence~\cite {schwank2013radiation,coronetti2021systemlevel}.}}{66}{figure.3.11}%
\contentsline {figure}{\numberline {4.1}{\ignorespaces Cross-sectional schematic of the \emph {pin} perovskite device structure used throughout this chapter. The ITO/hole-transport-layer (HTL) contact serves as the illuminated face for both photovoltaic and radiation-monitoring operation; the Ag back contact completes the Cs$_{0.1}$FA$_{0.9}$PbI$_3$ absorber sandwich.}}{75}{figure.4.1}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Photovoltaic performance of the Cs$_{0.1}$FA$_{0.9}$PbI$_3$ devices used in this study. (a)~J-V curve for the 8~mm$^2$ small cell (PCE = 21.3\%, $V_{\rm OC}$ = 1.13~V, $J_{\rm SC}$ = 23.0~mA\,cm$^{-2}$, FF = 81.8\%). (b)~J-V curve for the 63.7~cm$^2$ module (PCE = 16.9\%, $V_{\rm OC}$ = 18.9~V, $J_{\rm SC}$ = 74.5~mA\,cm$^{-2}$, FF = 76.2\%). All measurements performed at UNC Chapel Hill under AM1.5G illumination prior to shipment.}}{76}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Current-voltage characteristics of the Cs$_{0.1}$FA$_{0.9}$PbI$_3$ module under Amptek Mini-X X-ray tube illumination at tube voltages from 10~kV to 50~kV. Inset: $I_{\rm SC}$ at 50~kV as a function of irradiation time, showing the characteristic slow decline associated with ion migration under the built-in field~\cite {Thiesbrummel2024ionmig}.}}{79}{figure.4.3}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Short-circuit current $I_{\rm SC}$ of the Cs$_{0.1}$FA$_{0.9}$PbI$_3$ module as a function of time during insertion into and withdrawal from the $^{137}$Cs irradiator (dose rate = 44.16~rad\,hr$^{-1}$ in perovskite). The step changes in $I_{\rm SC}$ provide an unambiguous current-mode detection signal.}}{81}{figure.4.4}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Long-term evolution of $I_{\rm SC}$ under continuous $^{137}$Cs irradiation (44.16~rad\,hr$^{-1}$) over six days. The linear decline in $I_{\rm SC}$ with accumulated dose is attributed to a combination of radiation-induced defect creation in the perovskite absorber and progressive reduction in the optical transmittance of the glass superstrate~\cite {Boldyreva2020gammarad}.}}{82}{figure.4.5}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Short-circuit current $I_{\rm SC}$ of the module during 16-day continuous $^{60}$Co irradiation (dose rate = 355.61~rad\,hr$^{-1}$ in perovskite). The downward trend mirrors that observed for $^{137}$Cs (Figure~\ref {fig:cs137_longterm}) and scales approximately with the higher absorbed dose rate.}}{84}{figure.4.6}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces X-ray sensitivity of the MAPbI$_3$-hBN detector as a function of applied reverse bias. Sensitivity increases monotonically with field, consistent with improved charge collection efficiency described by the Hecht equation (Equation~\ref {eq:hecht}). Error bars represent the spread between repeated measurements at the same bias condition.}}{100}{figure.5.1}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Comparison of X-ray current transients at 5, 10, and 20~V applied bias for the MAPbI$_3$-hBN device in ambient air (solid curves) and under vacuum (dashed curves). Vacuum operation consistently produces a larger and more stable radiation-induced current, attributed to suppression of moisture-accelerated ion migration.}}{102}{figure.5.2}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Pulse-height spectrum acquired from the CsPbBr$_3$ detector at 1000~V reverse bias with the $^{137}$Cs source present (solid line) and background-only (dashed line). A clear elevation in total count rate is observed with the source, but no resolved photopeak is apparent due to the high electronic noise from the large device leakage current. The anomalous feature near channel 16,382 is attributed to ADC saturation from ion-migration-induced current spikes.}}{113}{figure.5.3}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces (a) Pulse-height spectrum from the FAPbBr$_3$ detector under $^{137}$Cs irradiation at 700~V reverse bias, showing a broad peak feature near the expected photopeak channel. (b) Spectrum comparison at 1600~V with $^{137}$Cs (5~$\mu $Ci) and $^{57}$Co (100~$\mu $Ci). Acquisition count rates: background 9.11~cps, $^{137}$Cs 17.45~cps, $^{57}$Co 26.60~cps. The distinct features associated with each source's primary gamma energies can be resolved from the background continuum.}}{116}{figure.5.4}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Neutron energy spectrum at the OSURR Fast Beam Facility determined by SAND-II unfolding of Cu, Au, and Ni activation wire measurements. The spectrum is dominated by fast neutrons with energies from 0.1 to 10~MeV.}}{121}{figure.5.5}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Representative preamplifier waveforms from the MHyPbCl$_3$ detector at 120~V reverse bias at the OSURR FBF. (a) Gamma shutter open (mixed field). (b) Gamma shutter closed (reduced gamma, fast neutron dominant). (c) Beam background acquired in the shutter-closed configuration with the reactor at power. Radiation-induced pulses are visible above the noise floor in all three configurations.}}{122}{figure.5.6}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Pulse-height spectrum reconstructed from LOWESS-filtered waveforms from the MHyPbCl$_3$ detector at 120~V reverse bias. (a) No gamma filter applied (mixed field). (b) Gamma shutter closed. The broad continuum is consistent with the expected proton-recoil energy deposition spectrum from a poly-energetic fast neutron beam.}}{124}{figure.5.7}%
\contentsline {figure}{\numberline {6.1}{\ignorespaces Cross-sectional view of the OFBGT.}}{137}{figure.6.1}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Overall view of the OFBGT.}}{138}{figure.6.2}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Internal view of the OFBGT active sensor region.}}{139}{figure.6.3}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Temperature distributions for the OFBGT and OFBND.}}{146}{figure.6.4}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Normalized MTF curves for the OFBGT and OFBND.}}{147}{figure.6.5}%
\contentsline {figure}{\numberline {7.1}{\ignorespaces Neutron fluence (fast, thermal, and total) accumulated during the Day~1 (gamma shutter closed) reactor run at the OSURR FNBF. The fast and total curves are nearly coincident, confirming fast-neutron dominance at this beam configuration.}}{163}{figure.7.1}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Neutron flux (fast, thermal, and total) during the Day~1 (gamma shutter closed) run. Fast flux reached a steady-state value of approximately $2 \times 10^5$~n/cm$^2$/s; the thermal component was approximately one order of magnitude lower.}}{164}{figure.7.2}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Reactor power profile during the Day~1 run. Full power ($\sim $300~kW) was reached within approximately 10~minutes of start-up and sustained for approximately 4.7~hours before controlled shutdown.}}{165}{figure.7.3}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Neutron fluence (fast, thermal, and total) accumulated during the Day~2 (gamma shutter open) reactor run. Total fast fluence reached approximately $8$--$9 \times 10^{11}$~n/cm$^2$, roughly two orders of magnitude greater than Day~1.}}{167}{figure.7.4}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Neutron flux during the Day~2 (gamma shutter open) run. Fast flux reached approximately $1.5 \times 10^7$~n/cm$^2$/s and thermal flux approximately $6 \times 10^6$~n/cm$^2$/s, narrowing the fast-to-thermal ratio compared with Day~1.}}{168}{figure.7.5}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Reactor power profile during the Day~2 run. Full power was sustained for approximately 8.5~hours before shutdown.}}{169}{figure.7.6}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Overlay of total neutron fluence (fast~+~thermal) for the Day~1 (shutter closed) and Day~2 (shutter open) runs, illustrating the approximately two-orders-of-magnitude difference in accumulated fluence between the two configurations.}}{171}{figure.7.7}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Overlay of total neutron flux for both runs. The Day~2 (open shutter) flux exceeded the Day~1 (closed shutter) flux by approximately two orders of magnitude throughout the steady-state period.}}{172}{figure.7.8}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Reactor power overlay for both runs on a linear scale. Both days operated at the same nominal reactor power ($\sim $300--400~kW); the large difference in neutron flux between the two days arose entirely from the gamma shutter configuration, not from a change in reactor power.}}{173}{figure.7.9}%
\contentsline {figure}{\numberline {7.10}{\ignorespaces PSU current for the CMOD board array during the Day~1 (gamma shutter closed) reactor run. Current stabilises near 0.284~A after initial power-up and remains flat throughout, indicating no measurable TID-induced leakage accumulation at the Day~1 fluence level ($\sim $$6$--$7 \times 10^9$ n/cm$^2$).}}{176}{figure.7.10}%
\contentsline {figure}{\numberline {7.11}{\ignorespaces PSU current for the CMOD board array during the overnight (out-of-beam) monitoring period (January~27--28). Current is stable near 0.284~A with occasional small transient spikes, confirming normal device operation at ambient background radiation levels.}}{178}{figure.7.11}%
\contentsline {figure}{\numberline {7.12}{\ignorespaces PSU current for the CMOD board array during the first part of the Day~2 (gamma shutter open) reactor run. A steady monotonic increase from approximately 0.28~A to 0.315~A ($\sim $12.5\%) is visible over the $\sim $7-hour logging window, consistent with TID-induced leakage current accumulation. Step increases near 2\,800~s and 5\,000~s correspond to the approximate times of the FFSR4 and FFSR3 dropouts.}}{181}{figure.7.12}%
\contentsline {figure}{\numberline {7.13}{\ignorespaces PSU current for the CMOD board array during the second part of the Day~2 run. Current continues near 0.315~A with a slow upward trend; brief sharp transients are consistent with transient radiation-induced events.}}{181}{figure.7.13}%
\contentsline {figure}{\numberline {8.1}{\ignorespaces Setpoint $r$ overlay. Run~1 (blue) and Run~2 (red) track identically for the first ${\sim }10{,}000$\,s. Run~1 exhibits corrupted setpoint values after $t = 10{,}000$\,s, temporally distinct from the plant-state decay onset at $t \approx 2{,}500$\,s.}}{203}{figure.8.1}%
\contentsline {figure}{\numberline {8.2}{\ignorespaces Fuel temperature $T_f$ overlay. Run~1 (blue) begins a smooth decay near $t = 2{,}500$\,s, reaching the zero clamp by $t \approx 5{,}000$\,s. Run~2 (red) maintains stable periodic operation.}}{204}{figure.8.2}%
\contentsline {figure}{\numberline {8.3}{\ignorespaces Coolant temperature $T_c$ overlay. Same decay morphology as $T_f$ with a slight lag, consistent with the thermal coupling between the two plant nodes.}}{205}{figure.8.3}%
\contentsline {figure}{\numberline {8.4}{\ignorespaces Outlet temperature $y$ overlay. The outlet tracks the coolant temperature decay through the first-order transport lag.}}{205}{figure.8.4}%
\contentsline {figure}{\numberline {8.5}{\ignorespaces Fuel temperature difference (Run~1 $-$ Run~2). The smooth onset near $t = 2{,}000$\,s saturates at approximately $-0.72$. The difference statistics are $|\max | = 7.54 \times 10^{-1}$, $\mu = -4.68 \times 10^{-1}$, $\sigma = 3.21 \times 10^{-1}$.}}{206}{figure.8.5}%
\contentsline {figure}{\numberline {8.6}{\ignorespaces Coolant temperature difference (Run~1 $-$ Run~2). Same morphology as the fuel temperature difference, saturating at approximately $-0.62$.}}{206}{figure.8.6}%
\contentsline {figure}{\numberline {8.7}{\ignorespaces Error signal $e = r - y_m$ overlay. Run~1 error grows monotonically as plant temperatures collapse, reaching $e \approx 0.60$ (the setpoint value) once $y_m$ reaches zero.}}{207}{figure.8.7}%
\contentsline {figure}{\numberline {8.8}{\ignorespaces Valve position $v$ overlay. Run~1 (blue) valve collapses to near-zero after the plant-state failure. Run~2 (red) exhibits the expected periodic actuation pattern driven by the ROM stimulus cycle.}}{207}{figure.8.8}%
