\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Measured SEGR onset $V_{\rm  GS}$ as a function of heavy-ion LET for several gate-metal species. The onset voltage decreases with increasing LET, imposing a derating requirement on operating voltage for power devices in heavy-ion environments~\cite  {sexton2003destructive}.}}{56}{figure.3.8}\protected@file@percent }
\newlabel{fig:SEGR_onset}{{3.8}{56}{Measured SEGR onset $V_{\rm GS}$ as a function of heavy-ion LET for several gate-metal species. The onset voltage decreases with increasing LET, imposing a derating requirement on operating voltage for power devices in heavy-ion environments~\cite {sexton2003destructive}}{figure.3.8}{}}
