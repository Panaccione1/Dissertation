\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Cross-sectional schematic of single-event burnout (SEB) in an n-channel power MOSFET. The heavy-ion track (dashed) deposits charge in the epitaxial drain that forward-biases the parasitic n-p-n transistor base-emitter junction, initiating regenerative feedback and destructive current~\cite  {sexton2003destructive}.}}{54}{figure.3.6}\protected@file@percent }
\newlabel{fig:SEB_xsec}{{3.6}{54}{Cross-sectional schematic of single-event burnout (SEB) in an n-channel power MOSFET. The heavy-ion track (dashed) deposits charge in the epitaxial drain that forward-biases the parasitic n-p-n transistor base-emitter junction, initiating regenerative feedback and destructive current~\cite {sexton2003destructive}}{figure.3.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Single-event gate rupture (SEGR) mechanism. The transient increase in gate-oxide field caused by the ion-track plasma can locally exceed the intrinsic breakdown field of the SiO$_2$, permanently rupturing the gate dielectric and rendering the transistor non-functional~\cite  {sexton2003destructive}.}}{55}{figure.3.7}\protected@file@percent }
\newlabel{fig:SEGR_diagram}{{3.7}{55}{Single-event gate rupture (SEGR) mechanism. The transient increase in gate-oxide field caused by the ion-track plasma can locally exceed the intrinsic breakdown field of the SiO$_2$, permanently rupturing the gate dielectric and rendering the transistor non-functional~\cite {sexton2003destructive}}{figure.3.7}{}}
