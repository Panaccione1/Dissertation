\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Neutron fluence (fast, thermal, and total) accumulated during the Day~1 (gamma shutter closed) reactor run at the OSURR FNBF. The fast and total curves are nearly coincident, confirming fast-neutron dominance at this beam configuration.}}{99}{figure.5.1}\protected@file@percent }
\newlabel{fig:ch6_day1_fluence}{{5.1}{99}{Neutron fluence (fast, thermal, and total) accumulated during the Day~1 (gamma shutter closed) reactor run at the OSURR FNBF. The fast and total curves are nearly coincident, confirming fast-neutron dominance at this beam configuration}{figure.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Neutron flux (fast, thermal, and total) during the Day~1 (gamma shutter closed) run. Fast flux reached a steady-state value of approximately $2 \times 10^5$~n/cm$^2$/s; the thermal component was approximately one order of magnitude lower.}}{100}{figure.5.2}\protected@file@percent }
\newlabel{fig:ch6_day1_flux}{{5.2}{100}{Neutron flux (fast, thermal, and total) during the Day~1 (gamma shutter closed) run. Fast flux reached a steady-state value of approximately $2 \times 10^5$~n/cm$^2$/s; the thermal component was approximately one order of magnitude lower}{figure.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Reactor power profile during the Day~1 run. Full power ($\sim $300~kW) was reached within approximately 10~minutes of start-up and sustained for approximately 4.7~hours before controlled shutdown.}}{101}{figure.5.3}\protected@file@percent }
\newlabel{fig:ch6_day1_power}{{5.3}{101}{Reactor power profile during the Day~1 run. Full power ($\sim $300~kW) was reached within approximately 10~minutes of start-up and sustained for approximately 4.7~hours before controlled shutdown}{figure.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Neutron fluence (fast, thermal, and total) accumulated during the Day~2 (gamma shutter open) reactor run. Total fast fluence reached approximately $8$--$9 \times 10^{11}$~n/cm$^2$, roughly two orders of magnitude greater than Day~1.}}{102}{figure.5.4}\protected@file@percent }
\newlabel{fig:ch6_day2_fluence}{{5.4}{102}{Neutron fluence (fast, thermal, and total) accumulated during the Day~2 (gamma shutter open) reactor run. Total fast fluence reached approximately $8$--$9 \times 10^{11}$~n/cm$^2$, roughly two orders of magnitude greater than Day~1}{figure.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces Neutron flux during the Day~2 (gamma shutter open) run. Fast flux reached approximately $1.5 \times 10^7$~n/cm$^2$/s and thermal flux approximately $6 \times 10^6$~n/cm$^2$/s, narrowing the fast-to-thermal ratio compared with Day~1.}}{103}{figure.5.5}\protected@file@percent }
\newlabel{fig:ch6_day2_flux}{{5.5}{103}{Neutron flux during the Day~2 (gamma shutter open) run. Fast flux reached approximately $1.5 \times 10^7$~n/cm$^2$/s and thermal flux approximately $6 \times 10^6$~n/cm$^2$/s, narrowing the fast-to-thermal ratio compared with Day~1}{figure.5.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Reactor power profile during the Day~2 run. Full power was sustained for approximately 8.5~hours before shutdown.}}{104}{figure.5.6}\protected@file@percent }
\newlabel{fig:ch6_day2_power}{{5.6}{104}{Reactor power profile during the Day~2 run. Full power was sustained for approximately 8.5~hours before shutdown}{figure.5.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces Overlay of total neutron fluence (fast~+~thermal) for the Day~1 (shutter closed) and Day~2 (shutter open) runs, illustrating the approximately two-orders-of-magnitude difference in accumulated fluence between the two configurations.}}{105}{figure.5.7}\protected@file@percent }
\newlabel{fig:ch6_overlay_fluence}{{5.7}{105}{Overlay of total neutron fluence (fast~+~thermal) for the Day~1 (shutter closed) and Day~2 (shutter open) runs, illustrating the approximately two-orders-of-magnitude difference in accumulated fluence between the two configurations}{figure.5.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.8}{\ignorespaces Overlay of total neutron flux for both runs. The Day~2 (open shutter) flux exceeded the Day~1 (closed shutter) flux by approximately two orders of magnitude throughout the steady-state period.}}{106}{figure.5.8}\protected@file@percent }
\newlabel{fig:ch6_overlay_flux}{{5.8}{106}{Overlay of total neutron flux for both runs. The Day~2 (open shutter) flux exceeded the Day~1 (closed shutter) flux by approximately two orders of magnitude throughout the steady-state period}{figure.5.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.9}{\ignorespaces Reactor power overlay for both runs on a linear scale. Both days operated at the same nominal reactor power ($\sim $300--400~kW); the large difference in neutron flux between the two days arose entirely from the gamma shutter configuration, not from a change in reactor power.}}{107}{figure.5.9}\protected@file@percent }
\newlabel{fig:ch6_overlay_power}{{5.9}{107}{Reactor power overlay for both runs on a linear scale. Both days operated at the same nominal reactor power ($\sim $300--400~kW); the large difference in neutron flux between the two days arose entirely from the gamma shutter configuration, not from a change in reactor power}{figure.5.9}{}}
