\@writefile{lof}{\contentsline {figure}{\numberline {7.12}{\ignorespaces PSU current for the CMOD board array during the first part of the Day~2 (gamma shutter open) reactor run. A steady monotonic increase from approximately 0.28~A to 0.315~A ($\sim $12.5\%) is visible over the $\sim $7-hour logging window, consistent with TID-induced leakage current accumulation. Step increases near 2\,800~s and 5\,000~s correspond to the approximate times of the FFSR4 and FFSR3 dropouts.}}{181}{figure.7.12}\protected@file@percent }
\newlabel{fig:ch6_day2_cmod_part1}{{7.12}{181}{PSU current for the CMOD board array during the first part of the Day~2 (gamma shutter open) reactor run. A steady monotonic increase from approximately 0.28~A to 0.315~A ($\sim $12.5\%) is visible over the $\sim $7-hour logging window, consistent with TID-induced leakage current accumulation. Step increases near 2\,800~s and 5\,000~s correspond to the approximate times of the FFSR4 and FFSR3 dropouts}{figure.7.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.13}{\ignorespaces PSU current for the CMOD board array during the second part of the Day~2 run. Current continues near 0.315~A with a slow upward trend; brief sharp transients are consistent with transient radiation-induced events.}}{181}{figure.7.13}\protected@file@percent }
\newlabel{fig:ch6_day2_cmod_part2}{{7.13}{181}{PSU current for the CMOD board array during the second part of the Day~2 run. Current continues near 0.315~A with a slow upward trend; brief sharp transients are consistent with transient radiation-induced events}{figure.7.13}{}}
